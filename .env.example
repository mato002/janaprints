APP_NAME="Jana Prints"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=janaprintsDB
DB_USERNAME=root
DB_PASSWORD=

# Bootstrap Super Admin (used by php artisan db:seed)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@janaprints.local
ADMIN_PASSWORD=

# Demo staff password (DemoUsersSeeder) — defaults to "password" when unset
# DEMO_USER_PASSWORD=password

# Client portal demo account (ClientDemoUserSeeder)
CLIENT_DEMO_NAME="Demo Client"
CLIENT_DEMO_EMAIL=client@janaprints.local
CLIENT_DEMO_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "log" for local dev without SMTP; use "smtp" for real delivery
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Password reset — uses the same cPanel SMTP mailer and From address as employee onboarding.
# AUTH_MAIL_MAILER=onboarding
# AUTH_MAIL_FROM_ADDRESS=info@janaprints.co.ke
# AUTH_MAIL_REPLY_TO=info@janaprints.co.ke
# Throttle between reset emails (seconds). Defaults to 0 locally, 60 in production.
# AUTH_PASSWORD_RESET_THROTTLE=0

# Optional legacy aliases (used as fallbacks when MAIL_USERNAME/MAIL_PASSWORD are empty)
EMAIL_USER=
EMAIL_PASS=

# Public storefront lead notifications (falls back to MAILBOX_INFO)
JANAPRINTS_ADMIN_EMAIL=info@janaprints.co.ke
PUBLIC_LEADS_MAIL_MAILER=onboarding
PUBLIC_LEADS_REPLY_TO=info@janaprints.co.ke

# Employee email identity — personal email onboarding (invitation + ERP login)
MAILBOX_SUPPORT=support@janaprints.co.ke
MAILBOX_INFO=info@janaprints.co.ke
MAILBOX_HR=hr@janaprints.co.ke
MAILBOX_ACCOUNTS=accounts@janaprints.co.ke
MAILBOX_PRODUCTION=production@janaprints.co.ke
MAILBOX_SALES=sales@janaprints.co.ke
MAILBOX_NOTIFICATIONS=notifications@janaprints.co.ke
MAILBOX_NOREPLY=noreply@janaprints.co.ke
MAILBOX_BILLING=billing@janaprints.co.ke
EMPLOYEE_ACTIVATION_EXPIRY_HOURS=72
EMPLOYEE_DEFAULT_ROLE_FALLBACK=Staff,Viewer
EMPLOYEE_ONBOARDING_SMS_ENABLED=true
EMPLOYEE_ONBOARDING_SMS_MESSAGE="Welcome to Jana Prints. Your onboarding link has been sent to your personal email. Please check your inbox."
EMPLOYEE_ONBOARDING_SMS_INCLUDE_LINK=false

# Deprecated — use EMPLOYEE_DEFAULT_ROLE_FALLBACK instead
EMPLOYEE_DEFAULT_ROLE=Viewer

# ---------------------------------------------------------------------------
# LOCAL EMAIL TESTING (development only)
# Set EMAIL_LOCAL_TESTING=true to send onboarding mail via Gmail/dev SMTP.
# Set EMAIL_LOCAL_TESTING=false and restore ONBOARDING_MAIL_* for production.
# ---------------------------------------------------------------------------
EMAIL_LOCAL_TESTING=false
EMAIL_LOCAL_TEST_FROM=
EMAIL_LOCAL_TEST_REPLY_TO=
EMAIL_LOCAL_TEST_MAILER=onboarding
EMAIL_LOCAL_TEST_OVERRIDE_SENDERS=true
EMAIL_LOCAL_TEST_SHOW_BANNER=true

# Employee onboarding SMTP — info@janaprints.co.ke (cPanel Secure SSL/TLS, port 465)
ONBOARDING_MAIL_MAILER=onboarding
ONBOARDING_MAIL_HOST=mail.janaprints.co.ke
ONBOARDING_MAIL_PORT=465
ONBOARDING_MAIL_SCHEME=smtps
ONBOARDING_MAIL_USERNAME=info@janaprints.co.ke
ONBOARDING_MAIL_PASSWORD=
ONBOARDING_MAIL_FROM_ADDRESS=info@janaprints.co.ke
ONBOARDING_MAIL_FROM_NAME="${APP_NAME}"
ONBOARDING_MAIL_REPLY_TO=info@janaprints.co.ke

# cPanel API — manage company mailboxes from Administration → System Settings → Company Email
# Hostname only — no https:// prefix (e.g. janaprints.co.ke or server hostname from WHM)
CPANEL_HOST=
CPANEL_USERNAME=
CPANEL_API_TOKEN=
CPANEL_PORT=2083
CPANEL_MAILBOX_QUOTA_MB=250
CPANEL_VERIFY_SSL=true
MAILBOX_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jana Prints commercial document branding (quotation, invoice, receipt PDF/print)
# Managed from Administration → Commercial Documents → Document Settings.
# These env values remain as deployment fallbacks when nothing is saved in the admin dashboard.
DOCUMENT_COMPANY_NAME="Jana Prints"
DOCUMENT_COMPANY_ADDRESS="Nakuru, 20100, Kenya"
DOCUMENT_COMPANY_PHONE="0711 839 219"
DOCUMENT_COMPANY_EMAIL="info@janaprints.co.ke"
DOCUMENT_COMPANY_WEBSITE="www.janaprints.co.ke"

DOCUMENT_MPESA_PAYBILL="880100"
DOCUMENT_MPESA_ACCOUNT="559888"

DOCUMENT_CHEQUE_PAYABLE_TO="JANA PRINTS"

DOCUMENT_BANK_NAME="NCBA Bank"
DOCUMENT_BANK_BRANCH="Nakuru Branch"
DOCUMENT_BANK_ACCOUNT_NAME="Jana Prints"
DOCUMENT_BANK_ACCOUNT_NUMBER="1001798601"
