APP_NAME="Jana Prints"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=janaprintsDB
DB_USERNAME=root
DB_PASSWORD=

# Bootstrap Super Admin (used by php artisan db:seed)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@janaprints.local
ADMIN_PASSWORD=

# Demo staff password (DemoUsersSeeder) — defaults to "password" when unset
# DEMO_USER_PASSWORD=password

# Client portal demo account (ClientDemoUserSeeder)
CLIENT_DEMO_NAME="Demo Client"
CLIENT_DEMO_EMAIL=client@janaprints.local
CLIENT_DEMO_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "log" for local dev without SMTP; use "smtp" for real delivery
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional legacy aliases (used as fallbacks when MAIL_USERNAME/MAIL_PASSWORD are empty)
EMAIL_USER=
EMAIL_PASS=

# Public storefront lead notifications (falls back to MAIL_FROM_ADDRESS)
JANAPRINTS_ADMIN_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jana Prints commercial document branding (quotation, invoice, receipt PDF/print)
DOCUMENT_COMPANY_NAME="Jana Prints"
DOCUMENT_COMPANY_ADDRESS="Nakuru, 20100, Kenya"
DOCUMENT_COMPANY_PHONE="0711 839 219"
DOCUMENT_COMPANY_EMAIL="info@janaprints.com"
DOCUMENT_COMPANY_WEBSITE="www.janaprints.com"

DOCUMENT_MPESA_PAYBILL="880100"
DOCUMENT_MPESA_ACCOUNT="559888"

DOCUMENT_CHEQUE_PAYABLE_TO="JANA PRINTS"

DOCUMENT_BANK_NAME="NCBA Bank"
DOCUMENT_BANK_BRANCH="Nakuru Branch"
DOCUMENT_BANK_ACCOUNT_NAME="Jana Prints"
DOCUMENT_BANK_ACCOUNT_NUMBER="1001798601"
